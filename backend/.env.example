# Copy to .env and fill in real values. .env is gitignored; this template is committed.

# development (default) or production. In production the app refuses to start with
# unsafe settings (a weak JWT secret, OTP_DEV_ECHO=true, ...): see app/core/config.py.
ENVIRONMENT=development

DATABASE_URL=mysql+aiomysql://taskvault:change_me_please@localhost:3306/taskvault?charset=utf8mb4
SQL_ECHO=false

# Generate with:  uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace_me_with_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: lets several server processes share the cache, rate limits and live events.
# REDIS_URL=redis://localhost:6379/0

# Phone verification. "console" prints codes in the server log instead of texting them.
# For real users: a real SMS_PROVIDER, OTP_DEV_ECHO=false, REQUIRE_VERIFIED_PHONE=true.
# SMS_PROVIDER=console
# OTP_DEV_ECHO=true
# REQUIRE_VERIFIED_PHONE=false

# Outside map services, called by the API (address search and road routes). The defaults
# are free community servers: fine for development. Leave a value empty to switch it off.
# GEOCODER_URL=https://nominatim.openstreetmap.org
# GEOCODER_COUNTRY_CODES=in
# ROUTING_URL=https://router.project-osrm.org
# How the app introduces itself to them. When you deploy, name your site or a contact.
# OUTBOUND_USER_AGENT=rideshare-web-app/0.1

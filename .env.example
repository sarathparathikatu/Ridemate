# Secrets for docker-compose.yml. Copy to .env (which git ignores) and change every value.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# development: relaxed, for trying the stack on your own machine.
# production: the API refuses to start with unsafe settings (a weak JWT_SECRET_KEY,
# OTP_DEV_ECHO=true, ...) and logs a warning for anything worth a second look.
ENVIRONMENT=development

# Development conveniences. For real users: OTP_DEV_ECHO=false, a real SMS provider,
# and REQUIRE_VERIFIED_PHONE=true (see docs/DEPLOYMENT.md).
OTP_DEV_ECHO=true
REQUIRE_VERIFIED_PHONE=false

# How the API introduces itself to the outside map services (address search, routes).
# Their usage policies ask for something that identifies your app: your site or a contact.
OUTBOUND_USER_AGENT=rideshare-web-app/0.1
